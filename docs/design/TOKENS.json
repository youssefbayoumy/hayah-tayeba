{
  "name": "Hayah Tayeba Offline MVP",
  "status": "design proposal",
  "basedOn": "v0.4 DEC-02/03/04",
  "locale": "ar",
  "direction": "rtl",
  "units": "logical px",
  "color": {
    "canvas": "#F7F8F5",
    "surface": "#FFFFFF",
    "ink": "#243B36",
    "textSecondary": "#566961",
    "accent": "#246B60",
    "accentPressed": "#1D574E",
    "accentSoft": "#E8F0EB",
    "border": "#C9D3CC",
    "controlBorder": "#6F8279",
    "error": "#8B4B3F",
    "errorSoft": "#F3E9E5",
    "illustrationOnly": { "sand": "#D9C9AC", "leaf": "#BFCFBF", "stone": "#C5CECA", "clay": "#CBAF9C" }
  },
  "typography": {
    "nativeBundledFamily": "Noto Sans Arabic",
    "nativeWeights": [400, 500, 600, 700],
    "webFallbackStack": ["Noto Sans Arabic", "Tahoma", "Arial", "sans-serif"],
    "letterSpacing": 0,
    "allowFontScaling": true,
    "display": { "size": 28, "lineHeight": 42, "weight": 700 },
    "heading": { "size": 24, "lineHeight": 36, "weight": 700 },
    "section": { "size": 20, "lineHeight": 32, "weight": 600 },
    "body": { "size": 18, "lineHeight": 30, "weight": 400 },
    "supporting": { "size": 16, "lineHeight": 26, "weight": 400 },
    "caption": { "size": 14, "lineHeight": 24, "weight": 500 },
    "button": { "size": 17, "lineHeight": 28, "weight": 600 }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 40, 48],
  "layout": { "referenceWidth": 390, "referenceHeight": 844, "screenMargin": 24, "textColumnMax": 560, "touchTargetMin": 48, "targetGapMin": 8, "iconSize": 24 },
  "radius": { "small": 8, "choice": 12, "button": 16, "panel": 20, "artFrame": 24 },
  "borderWidth": { "default": 1, "selected": 2, "focus": 2 },
  "component": {
    "navigation": { "labelsInReadingOrder": ["الخريطة", "لحظاتي", "دفتر الرحلة"], "profileAndSettingsPlacement": "header", "rtlFirstDestination": "right" },
    "primaryButton": { "minHeight": 52, "horizontalPadding": 20, "radiusToken": "button" },
    "input": { "minHeight": 56, "padding": 16, "borderToken": "controlBorder" },
    "choice": { "minHeight": 64, "padding": 16, "gap": 12, "selectedFillToken": "accentSoft", "selectedBorderToken": "accent", "selectedIcon": "check" },
    "reflectionEditor": { "minHeight": 180, "padding": 16, "fontToken": "body", "textAlign": "right" }
  },
  "shadow": { "rarePanel": { "x": 0, "y": 4, "blur": 12, "color": "#243B36", "opacity": 0.06, "note": "Map explicitly to native shadow/elevation APIs; do not assume identical platform rendering." } },
  "motion": { "pressMs": 100, "selectionMs": 140, "transitionMs": 200, "celebrationMaxMs": 350, "pressScale": 0.98, "spring": { "stiffness": 100, "damping": 20 }, "perpetualLoops": false, "reduceMotion": "Immediate change or brief opacity; no positional movement.", "properties": ["transform", "opacity"] },
  "measuredContrast": [
    { "foreground": "ink", "background": "canvas", "ratio": 11.23 },
    { "foreground": "accent", "background": "canvas", "ratio": 5.89 },
    { "foreground": "surface", "background": "accent", "ratio": 6.27 },
    { "foreground": "textSecondary", "background": "canvas", "ratio": 5.49 },
    { "foreground": "textSecondary", "background": "surface", "ratio": 5.85 },
    { "foreground": "error", "background": "canvas", "ratio": 6.20 },
    { "foreground": "accent", "background": "accentSoft", "ratio": 5.41 },
    { "foreground": "border", "background": "canvas", "ratio": 1.44, "use": "Decorative only; not sufficient as an essential control boundary." }
  ],
  "offline": { "fontsBundled": true, "requiredMediaBundled": true, "remoteAssetsOnLearningPath": false, "firstUseDownloadRequired": false },
  "productConstraints": { "ageMin": 10, "ageMax": 14, "login": false, "motherExperience": false, "reflectionMode": "written", "reflectionOptional": true, "voiceRecording": false, "xpValuesApproved": false, "sevenDayGateApproved": false }
}
